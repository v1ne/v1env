// Waybar — v1env. Needs "Symbols Nerd Font" v3 (nerd-fonts.symbols-only / https://github.com/ryanoasis/nerd-fonts/)
// for the glyphs; text falls back to JetBrains Mono. Colours live in style.css (Kimbie).
{
    "layer": "top",
    "position": "top",
    "height": 16,
    "spacing": 4,
    "modules-left": ["sway/workspaces", "sway/mode", "sway/scratchpad"],
    "modules-center": ["sway/window"],
    "modules-right": ["idle_inhibitor", "pulseaudio", "cpu", "memory", "backlight", "battery", "clock", "tray"],

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": [""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "", "deactivated": "" }
    },
    "pulseaudio": {
        "format": "{volume:3}% {icon} {format_source}",
        "format-bluetooth": "{volume:3}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "$HOME/.config/waybar/audio-menu.py",
        "on-click-right": "pavucontrol"
    },
    "network": {
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "on-click-right": "pgrep -x nm-applet >/dev/null || nm-applet"
    },
    "cpu": {
        "format": "{usage:3}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{:3}% "
    },
    "backlight": {
        "format": "{percent:3}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{capacity:3}% {icon}",
        "format-charging": "{capacity:3}% ",
        "format-plugged": "{capacity:3}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "clock": {
        "format": "{:%H:%M}", // no icon: 
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d %a}"
    },
    "tray": {
        "spacing": 10
    }
}
